# CVA6 runs on clk_cpu = clk_main_a0 / 2 (125 MHz), generated by a fabric
# toggle flop through a BUFG. OCL remains on the Shell clock (250 MHz).
# The two domains are asynchronous from a timing-analysis point of view;
# CDC is an xpm_fifo_async (UART) plus 2-flop / toggle synchronizers.

create_generated_clock -name clk_cpu \
  -source [get_ports clk_main_a0] \
  -divide_by 2 \
  [get_pins -hierarchical -filter {NAME =~ *i_clk_cpu_buf/O}]

set_clock_groups -asynchronous \
  -group [get_clocks clk_main_a0] \
  -group [get_clocks clk_cpu]
